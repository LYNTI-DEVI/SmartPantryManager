<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recipe Details"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/app_heading"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/tvRecipeDetailsName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recipe Name"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/app_heading"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ingredients"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="@color/app_heading"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvRecipeIngredients"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recipe ingredients will appear here."
            android:textSize="16sp"
            android:textColor="@color/app_text"
            android:lineSpacingExtra="6dp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cooking Instructions"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="@color/app_heading"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvRecipeInstructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cooking instructions will appear here."
            android:textSize="16sp"
            android:textColor="@color/app_text"
            android:lineSpacingExtra="6dp"
            android:layout_marginBottom="24dp" />


        <Button
            android:id="@+id/btnBackToRecipes"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Back to Recipes"
            android:textSize="16sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/app_button" />

    </LinearLayout>

</ScrollView>