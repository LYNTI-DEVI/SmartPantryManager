<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/app_background"
    android:padding="16dp">

    <!-- Application Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="25dp">

        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Smart Pantry Manager"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/app_heading"
            android:gravity="center_vertical" />

        <TextView
            android:id="@+id/btnSettings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="⚙"
            android:textSize="28sp"
            android:textColor="@color/app_button"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Settings" />

    </LinearLayout>

    <!-- Pantry Heading -->
    <TextView
        android:id="@+id/tvPantryHeading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="My Pantry"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/app_heading"
        android:layout_marginBottom="15dp" />

    <!-- Ingredient List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewPantry"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="12dp" />

    <!-- Pantry Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="8dp">


        <Button
            android:id="@+id/btnAddIngredient"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="+ Add Ingredient"
            android:textSize="14sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/app_button"
            android:layout_marginEnd="6dp" />


        <Button
            android:id="@+id/btnRecommendedRecipes"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Recommended Recipes"
            android:textSize="14sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/app_button"
            android:layout_marginStart="6dp" />

    </LinearLayout>

</LinearLayout>