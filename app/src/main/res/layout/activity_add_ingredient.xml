<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/app_background">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add Ingredient"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/app_heading"
        android:gravity="center"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="30dp" />

    <EditText
        android:id="@+id/etIngredientName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ingredient Name (e.g. Pap)"
        android:inputType="textCapWords"
        android:layout_marginBottom="20dp" />

    <EditText
        android:id="@+id/etQuantity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Quantity (e.g. 12)"
        android:inputType="numberDecimal"
        android:layout_marginBottom="20dp" />

    <Spinner
        android:id="@+id/spinnerUnit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp" />

    <Button
        android:id="@+id/btnSaveIngredient"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Save Ingredient"
        android:textColor="@color/white"
        android:backgroundTint="@color/app_button"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnBackToPantry"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Back to Pantry"
        android:textColor="@color/white"
        android:backgroundTint="@color/app_button" />

</LinearLayout>