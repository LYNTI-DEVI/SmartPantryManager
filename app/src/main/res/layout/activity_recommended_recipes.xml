<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/app_background">

    <TextView
        android:id="@+id/tvRecommendedRecipesTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Recommended Recipes"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/app_heading"
        android:gravity="center"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvRecommendedRecipesDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:textColor="@color/app_text"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvNoRecipes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No matching recipes found. Try adding more ingredients to your pantry."
        android:textSize="16sp"
        android:textColor="@color/app_text"
        android:gravity="center"
        android:padding="20dp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewRecipes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />


    <Button
        android:id="@+id/btnBackToPantry"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Back to Pantry"
        android:textSize="16sp"
        android:textColor="@color/white"
        android:backgroundTint="@color/app_button"
        android:layout_marginTop="10dp" />

</LinearLayout>