<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FFFDF7">

    <TextView
        android:id="@+id/tvRecommendedRecipesTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Recommended Recipes"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#2E7D32"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvRecommendedRecipesDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Recipes you can prepare using the ingredients in your pantry."
        android:textSize="15sp"
        android:textColor="#555555"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvNoRecipes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No matching recipes found. Try adding more ingredients to your pantry."
        android:textSize="16sp"
        android:textColor="#777777"
        android:gravity="center"
        android:padding="20dp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewRecipes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Back to Pantry Button -->
    <Button
        android:id="@+id/btnBackToPantry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Back to Pantry"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#2E7D32"
        android:layout_marginTop="10dp" />

</LinearLayout>